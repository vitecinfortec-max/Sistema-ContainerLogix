# Copie para .env localmente, ou preencha estes valores como env vars no Render.

# Connection string do MongoDB (local: mongodb://localhost:27017 | Atlas: mongodb+srv://user:senha@cluster.mongodb.net)
MONGO_URL=
DB_NAME=containerlogix

# Origens permitidas por CORS, separadas por vírgula (sem espaço)
CORS_ORIGINS=https://sistema.containerlogix.com.br

# Chave usada para assinar os tokens JWT (gere uma string aleatória longa, ex: openssl rand -hex 32)
JWT_SECRET_KEY=

# Opcionais — envio de e-mail (recuperação de senha) via Resend. Deixe em branco se não usar.
RESEND_API_KEY=
SENDER_EMAIL=onboarding@resend.dev
