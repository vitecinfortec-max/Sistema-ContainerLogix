{
  "name": "containerlogix-desktop",
  "version": "1.0.0",
  "description": "ContainerLogix - Sistema de Movimentação de Contêineres (Desktop)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:win-msi": "electron-builder --win msi --x64",
    "build:win-portable": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.jalogistica.containerlogix",
    "productName": "ContainerLogix",
    "copyright": "Copyright © 2026 J.A Logística",
    "directories": {
      "output": "dist",
      "buildResources": "."
    },
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "icon.ico",
      "lib/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/python-runtime",
        "to": "python-runtime",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "resources/mongo-bin",
        "to": "mongo-bin"
      },
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!venv",
          "!venv/**",
          "!tests/**",
          "!scripts/**",
          "!__pycache__/**",
          "!**/__pycache__/**",
          "!*.pyc",
          "!.env",
          "!requirements.txt",
          "!requirements-desktop.txt"
        ]
      },
      {
        "from": "../frontend/build",
        "to": "frontend-build"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.ico",
      "publisherName": "J.A Logística",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ContainerLogix",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  },
  "author": "J.A Logística",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
